# ============================================================
# Daou Hub — 환경변수 (내일 아침 이 값들만 채우면 실데이터로 돎)
# 로컬:  cp pipeline/.env.example pipeline/.env  후 값 입력
# 배포:  GitHub → Settings → Secrets and variables → Actions 에 등록
# ============================================================

# ── (필수) 구글시트 RAW 저장소 ───────────────────────────
# RAW가 누적되는 스프레드시트 ID (주소 /d/<ID>/edit 의 <ID>)
# 제품별로 시트가 나뉘어 있으면 콤마로 여러 개: <ID1>,<ID2> (모두 같은 워크시트 이름 사용)
DAOU_SHEET_ID=
# RAW 워크시트(탭) 이름 (기본 RAW)
DAOU_SHEET_WORKSHEET=RAW
# 서비스계정 JSON 전체 (문자열). 이 서비스계정 이메일을 시트에 '편집자'로 공유할 것.
# (GA4 연동에 쓰던 것과 동일 계정 재사용 가능)
GA4_SERVICE_ACCOUNT_JSON=

# ── (선택) 네이버 검색광고 = 경쟁 키워드 실검색량 ────────
# 없으면 키워드 분석은 샘플로 동작
NAVER1_CUSTOMER_ID=
NAVER1_API_KEY=
NAVER1_SECRET_KEY=

# ── (선택) 네이버 개발자앱 = DataLab(성별·연령·추이) + 검색 API(콘텐츠수) ──
# 네이버 개발자센터에서 앱 등록 후 발급. 없으면 인구/추이/콘텐츠수는 모델 추정.
NAVER_DEV_CLIENT_ID=
NAVER_DEV_CLIENT_SECRET=

# ── (선택) YouTube Data API v3 = 키워드 상위 영상(썸네일·조회수) ──
# Google Cloud 에서 'YouTube Data API v3' 활성화 후 API 키 발급. 없으면 샘플 영상.
YOUTUBE_API_KEY=

# ── (선택) 경쟁 분석 대상 키워드 / 우리 브랜드 ───────────
DAOU_KEYWORDS=그룹웨어,전자결재,쇼핑몰 통합관리,재고관리 프로그램,채용 사이트,모바일 쿠폰
DAOU_OUR_BRAND=다우오피스

# ── (선택) RAW 컬럼 헤더가 다르면 여기서 덮어쓰기 ────────
# COL_SERVICE=서비스
# COL_MEDIA=매체
# COL_CAMPTYPE=캠페인유형
# COL_DATE=날짜
# COL_IMP=노출수
# COL_CLICK=클릭수
# COL_COST=광고비(마크업포함,VAT별도)
# COL_SIGNUP=가입

# ============================================================
# 참고) RAW 를 시트에 '적재'하는 건 기존 리포트 도구가 담당한다.
#   그 도구들이 매체 API를 부를 때 쓰는 키(아래)는 그 도구 쪽에 넣는다.
#   (adcon_report.py 등). 여기 파이프라인은 시트를 '읽기'만 한다.
#     GADS_DEVELOPER_TOKEN / GADS_CLIENT_ID / GADS_CLIENT_SECRET /
#     GADS_REFRESH_TOKEN / GADS_LOGIN_CUSTOMER_ID / GADS_CUSTOMER_ID(_2) /
#     NAVER2_* / META_* / GEMINI_API_KEY ...
# ============================================================
